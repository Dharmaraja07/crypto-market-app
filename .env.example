# ==============================================================================
# Crypto Market Research Application - Environment Variables
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (for PostgreSQL profile: SPRING_PROFILES_ACTIVE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_market_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# CoinGecko External API Configuration
# Optional: CoinGecko Demo or Pro API Key. Leave blank to use free public API tier.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_HEADER=x-cg-demo-api-key

# Resilience & Cache
COINGECKO_TIMEOUT_SECONDS=10
COINGECKO_MOCK_FALLBACK_ENABLED=true
CACHE_TTL_SECONDS=120
